# ATENÇÃO: não reutilize este projeto em testes com pessoas reais.
# Configure abaixo os valores PUBLICOS do app Web de um projeto Firebase SEPARADO.
# VITE_TOAKI_ENV=homologacao libera cadastros somente quando projectId != toaki-cf058
# e a Web API Key + App ID desse segundo projeto estiverem configurados.
VITE_TOAKI_ENV=preview
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Só habilitar após implantação e teste da função de análise no Firebase isolado.
VITE_ENABLE_ADMIN_APPROVAL=false
