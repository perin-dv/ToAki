{
  "name": "toaki-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/generate-pwa-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/protecao.test.mjs tests/ambiente-operacao.test.cjs tests/soma-sandbox.test.cjs tests/soma-criar-direto.test.cjs",
    "test:security": "firebase emulators:exec --only firestore --project demo-toaki-ci \"node --test tests/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^14.19.1"
  }
}
